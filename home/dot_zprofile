# Non-interactive login shells need native user-local tools too. Keep this
# silent and independent of prompts, completion, package managers and .zshrc.
typeset -U path PATH
[[ -d "$HOME/.local/bin" ]] && path=("$HOME/.local/bin" $path)
export PATH

# Keep machine-specific login environment here, never interactive prompts.
if [[ -r "$HOME/.zprofile.local" ]]; then
    source "$HOME/.zprofile.local"
fi
