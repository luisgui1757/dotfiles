  "bash_hooks": [
    {
      "tag": "v0.1.0",
      "commit": "015617362830280bf85c7142e69d0681d376d453",
      "source": "install-deps.sh",
      "sha256": "8764fca95db091c9bbcfdd97cf1c13d8c0f8371e9e7351d1bb5a94eb4b4b9789",
      "content": "# >>> dotfiles: exec zsh (interactive bash fallback) >>>\n# Interactive bash re-execs into zsh. Guards: not already zsh (no loop), only\n# interactive shells (scp/rsync/scripts stay bash), and zsh must be installed.\nif [ -z \"${ZSH_VERSION:-}\" ] && [ -n \"${BASH_VERSION:-}\" ] && [[ $- == *i* ]] && command -v zsh >/dev/null 2>&1; then\n    SHELL=\"$(command -v zsh)\"; export SHELL\n    exec zsh\nfi\n# <<< dotfiles: exec zsh (interactive bash fallback) <<<\n"
    },
