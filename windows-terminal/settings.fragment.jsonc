// Windows Terminal 1.25 — reviewed scoped settings recipe.
//
// The installer merges these fields into the pinned unpackaged stable instance:
//   %LOCALAPPDATA%\Microsoft\Windows Terminal\settings.json
// Unrelated settings and discovered profiles remain personal. Never symlink the
// complete file: Terminal itself may rewrite settings when discovering profiles.
// Store, Preview and Canary settings are independent of this managed instance.
//
// The fragment intentionally contains ONLY user-authored keys:
//   - modern keybindings and one fixed close-tab action
//   - defaults (font, color scheme)
//   - a repo-owned PowerShell 7 profile + defaultProfile
//   - copyFormatting / copyOnSelect / historySize / initialRows / windowingBehavior / launchMode
//   - the Rose Pine color scheme
//   - the Rose Pine theme
//   - useAcrylicInTabRow
//
// It does NOT contain machine-discovered `profiles.list[]` entries (WSL distros,
// Azure Cloud Shell, Visual Studio shells, etc.). The one fixed profile below
// exists so setup can make WT open the same PowerShell 7 profile that this repo
// installs and configures, without depending on WT dynamic-profile discovery.
{
    "$schema": "https://aka.ms/terminal-profiles-schema",

    "copyFormatting": "none",
    "copyOnSelect": false,
    "defaultProfile": "{8a0e8c9b-2b4c-5842-ac1b-29cd17efc89b}",
    "firstWindowPreference": "persistedLayoutAndContent",
    "initialRows": 50,
    "launchMode": "maximized",
    "theme": "rose-pine",
    "useAcrylicInTabRow": true,
    "windowingBehavior": "useAnyExisting",

    "actions": [
        { "id": "Dotfiles.CloseTab", "command": "closeTab" }
    ],
    "keybindings": [
        { "keys": "ctrl+c", "id": "Terminal.CopyToClipboard" },
        { "keys": "ctrl+v", "id": "Terminal.PasteFromClipboard" },
        { "keys": "ctrl+shift+f", "id": "Terminal.FindText" },
        { "keys": "alt+shift+d", "id": "Terminal.DuplicatePaneAuto" },
        { "keys": "ctrl+shift+w", "id": "Dotfiles.CloseTab" },
        { "keys": "ctrl+t", "id": "Terminal.OpenNewTab" },
        { "keys": "ctrl+tab", "id": "Terminal.NextTab" },
        { "keys": "ctrl+right", "id": "Terminal.NextTab" },
        { "keys": "ctrl+shift+tab", "id": "Terminal.PrevTab" },
        { "keys": "ctrl+left", "id": "Terminal.PrevTab" },
        { "keys": "ctrl+shift+up", "id": "Terminal.SplitPaneUp" },
        { "keys": "ctrl+shift+down", "id": "Terminal.SplitPaneDown" },
        { "keys": "ctrl+shift+right", "id": "Terminal.SplitPaneRight" },
        { "keys": "ctrl+shift+left", "id": "Terminal.SplitPaneLeft" },
        { "keys": "ctrl+alt+w", "id": "Terminal.ClosePane" }
    ],

    "profiles": {
        "defaults": {
            "colorScheme": "rose-pine",
            "font": { "face": "Hack Nerd Font", "size": 12 },
            "historySize": 32767,
            "opacity": 95,
            "useAcrylic": false,
            "padding": "6, 6, 6, 6",
            "antialiasingMode": "grayscale",
            "scrollbarState": "visible"
        },
        "list": [
            {
                "guid": "{8a0e8c9b-2b4c-5842-ac1b-29cd17efc89b}",
                "name": "PowerShell 7",
                "commandline": "pwsh.exe",
                "startingDirectory": "%USERPROFILE%"
            }
        ]
    },

    "schemes": [
        {
            "name": "rose-pine",
            "background": "#191724",
            "foreground": "#e0def4",
            "cursorColor": "#555169",
            "selectionBackground": "#2a2837",
            "black":         "#26233a",
            "red":           "#eb6f92",
            "green":         "#31748f",
            "yellow":        "#f6c177",
            "blue":          "#9ccfd8",
            "purple":        "#c4a7e7",
            "cyan":          "#ebbcba",
            "white":         "#e0def4",
            "brightBlack":   "#6e6a86",
            "brightRed":     "#eb6f92",
            "brightGreen":   "#31748f",
            "brightYellow":  "#f6c177",
            "brightBlue":    "#9ccfd8",
            "brightPurple":  "#c4a7e7",
            "brightCyan":    "#ebbcba",
            "brightWhite":   "#e0def4"
        }
    ],

    "themes": [
        {
            "name": "rose-pine",
            "tab": {
                "background": "#191724ff",
                "iconStyle": "default",
                "showCloseButton": "always",
                "unfocusedBackground": null
            },
            "tabRow": {
                "background": "#26233aff",
                "unfocusedBackground": "#908caaff"
            },
            "window": {
                "applicationTheme": "dark",
                "experimental.rainbowFrame": false,
                "frame": null,
                "unfocusedFrame": null,
                "useMica": false
            }
        }
    ]
}
