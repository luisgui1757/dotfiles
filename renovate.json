{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Renovate owns GitHub Actions, runner labels, Go toolchain/modules and CI validator/tool constants. It also lists new releases of the installer pins, the bootstrap toolchain, the Homebrew script and the Mason snapshot on the dashboard, but never changes them: they need checksum and runtime review. The daily agent-cli-pins workflow proposes verified archive updates from scripts/archive-pin-updates.json in one PR. The pin workflow holds major releases. Explicit manual exceptions need manual review.",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":dependencyDashboard",
    ":semanticCommits",
    ":timezone(Etc/UTC)"
  ],
  "enabledManagers": [
    "github-actions",
    "custom.regex",
    "gomod"
  ],
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "Renovate dashboard",
  "schedule": [
    "before 06:00"
  ],
  "minimumReleaseAge": "3 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "prConcurrentLimit": 4,
  "prHourlyLimit": 2,
  "labels": [
    "dependencies"
  ],
  "automerge": false,
  "rebaseWhen": "conflicted",
  "vulnerabilityAlerts": {
    "enabled": false
  },
  "lockFileMaintenance": {
    "enabled": false
  },
  "ignorePaths": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.venv/**",
    "tests/.cache/**",
    "tests/nvim/fixtures/go.mod",
    "vendor/**"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Neovim Linux x86_64 tarball version in CI. The adjacent SHA-256 must be recomputed manually after Renovate bumps this.",
      "managerFilePatterns": [
        "/^\\.github/workflows/test\\.yml$/"
      ],
      "matchStrings": [
        "NVIM_LINUX_VERSION:\\s*(?<currentValue>v[^\\s]+)\\s+NVIM_LINUX_X86_64_SHA256:\\s*[a-f0-9]{64}"
      ],
      "depNameTemplate": "neovim/neovim",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Starship Linux x86_64 release version in CI. The adjacent SHA-256 must be recomputed manually after Renovate bumps this.",
      "managerFilePatterns": [
        "/^\\.github/workflows/test\\.yml$/"
      ],
      "matchStrings": [
        "STARSHIP_VERSION:\\s*(?<currentValue>v[^\\s]+)\\s+STARSHIP_LINUX_X86_64_SHA256:\\s*[a-f0-9]{64}"
      ],
      "depNameTemplate": "starship/starship",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "tree-sitter CLI Linux x86_64 release version in CI. The adjacent SHA-256 must be recomputed manually after Renovate bumps this.",
      "managerFilePatterns": [
        "/^\\.github/workflows/test\\.yml$/"
      ],
      "matchStrings": [
        "TREE_SITTER_CLI_LINUX_VERSION:\\s*(?<currentValue>v[^\\s]+)\\s+TREE_SITTER_CLI_LINUX_X86_64_SHA256:\\s*[a-f0-9]{64}"
      ],
      "depNameTemplate": "tree-sitter/tree-sitter",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "cargo-binstall installer script commit pinned to the current main branch digest. The adjacent installer script SHA-256 must be recomputed manually after Renovate bumps this.",
      "managerFilePatterns": [
        "/^\\.github/workflows/test\\.yml$/"
      ],
      "matchStrings": [
        "CARGO_BINSTALL_COMMIT:\\s*(?<currentDigest>[a-f0-9]{40})\\s+CARGO_BINSTALL_INSTALLER_SHA256:\\s*[a-f0-9]{64}"
      ],
      "currentValueTemplate": "main",
      "depNameTemplate": "cargo-bins/cargo-binstall",
      "packageNameTemplate": "https://github.com/cargo-bins/cargo-binstall",
      "datasourceTemplate": "git-refs"
    },
    {
      "customType": "regex",
      "description": "Node runtime version used to run Renovate's schema validator.",
      "managerFilePatterns": [
        "/^scripts/validate-renovate\\.sh$/"
      ],
      "matchStrings": [
        "RENOVATE_NODE_VERSION=\"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "node",
      "datasourceTemplate": "npm",
      "versioningTemplate": "node"
    },
    {
      "customType": "regex",
      "description": "Renovate package version used by the required schema validator.",
      "managerFilePatterns": [
        "/^scripts/validate-renovate\\.sh$/"
      ],
      "matchStrings": [
        "RENOVATE_VERSION=\"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "renovate",
      "datasourceTemplate": "npm",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "GitHub runner labels stored in matrix include entries, which the built-in manager cannot extract through matrix variables.",
      "managerFilePatterns": [
        "/^\\.github/workflows/installer-engine\\.yml$/"
      ],
      "matchStrings": [
        "runner:\\s*(?<depName>ubuntu|macos|windows)-(?<currentValue>[^\\s#]+)"
      ],
      "datasourceTemplate": "github-runners",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Pinned Windows container image used for fresh native installer acceptance.",
      "managerFilePatterns": [
        "/^\\.github/workflows/installer-engine\\.yml$/"
      ],
      "matchStrings": [
        "WINDOWS_TEST_IMAGE:\\s*(?<depName>mcr\\.microsoft\\.com/dotnet/framework/runtime):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Pinned oldest supported Ubuntu image for the Ghostty library-compatibility check. Only digest updates apply: the tag must stay the oldest supported release.",
      "managerFilePatterns": [
        "/^\\.github/workflows/installer-engine\\.yml$/"
      ],
      "matchStrings": [
        "GHOSTTY_OLDEST_UBUNTU_IMAGE:\\s*(?<depName>ubuntu):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Release tag of each GitHub release download in the archive pins. Renovate only reports it; the daily pin workflow or a manual PR changes the pin and its checksum.",
      "managerFilePatterns": [
        "/^installer/archive-pins\\.json$/"
      ],
      "matchStrings": [
        "\"url\":\\s*\"https://github\\.com/(?<depName>[^/\"]+/[^/\"]+)/releases/download/(?<currentValue>[^/\"]+)/"
      ],
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "description": "GitLab CLI release in the archive pins. Renovate only reports it.",
      "managerFilePatterns": [
        "/^installer/archive-pins\\.json$/"
      ],
      "matchStrings": [
        "\"url\":\\s*\"https://gitlab\\.com/(?<depName>gitlab-org/cli)/-/releases/(?<currentValue>v[^/\"]+)/downloads/"
      ],
      "datasourceTemplate": "gitlab-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Ghostty macOS release in the archive pins. Renovate only reports it.",
      "managerFilePatterns": [
        "/^installer/archive-pins\\.json$/"
      ],
      "matchStrings": [
        "release\\.files\\.ghostty\\.org/(?<currentValue>[^/\"]+)/"
      ],
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "ghostty-org/ghostty",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "Python wheel and source package versions in the archive pins. Renovate only reports them.",
      "managerFilePatterns": [
        "/^installer/archive-pins\\.json$/"
      ],
      "matchStrings": [
        "files\\.pythonhosted\\.org/packages/[0-9a-f/]+/(?<depName>[A-Za-z0-9_.]+)-(?<currentValue>[0-9][^-\"]*)-[^\"]+\\.whl\"",
        "files\\.pythonhosted\\.org/packages/[0-9a-f/]+/(?<depName>[A-Za-z0-9_.]+)-(?<currentValue>[0-9][^\"]*)\\.tar\\.gz\""
      ],
      "datasourceTemplate": "pypi"
    },
    {
      "customType": "regex",
      "description": "Node.js release in the archive pins. Renovate only reports it.",
      "managerFilePatterns": [
        "/^installer/archive-pins\\.json$/"
      ],
      "matchStrings": [
        "nodejs\\.org/dist/v(?<currentValue>[0-9.]+)/"
      ],
      "datasourceTemplate": "node-version",
      "depNameTemplate": "node",
      "versioningTemplate": "node"
    },
    {
      "customType": "regex",
      "description": "Rust compiler release in the archive pins. Renovate only reports it; the components change with it.",
      "managerFilePatterns": [
        "/^installer/archive-pins\\.json$/"
      ],
      "matchStrings": [
        "static\\.rust-lang\\.org/dist/[0-9-]+/rustc-(?<currentValue>[0-9.]+)-"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "rust-lang/rust"
    },
    {
      "customType": "regex",
      "description": "VS Code release in the archive pins and the Linux Code pins. Renovate only reports it.",
      "managerFilePatterns": [
        "/^installer/archive-pins\\.json$/",
        "/^installer/linux-code-pins\\.json$/"
      ],
      "matchStrings": [
        "\"version\":\\s*\"(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)(?:-[0-9]+)?\",\\s*\"url\":\\s*\"https://vscode\\.download\\.prss\\.microsoft\\.com/"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "microsoft/vscode"
    },
    {
      "customType": "regex",
      "description": "Rose Pine VS Code extension in the archive pins. Renovate only reports it.",
      "managerFilePatterns": [
        "/^installer/archive-pins\\.json$/"
      ],
      "matchStrings": [
        "publishers/mvllow/vsextensions/rose-pine/(?<currentValue>[0-9.]+)/vspackage"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "rose-pine/vscode",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "PowerShell Gallery modules in the archive pins. Renovate only reports them.",
      "managerFilePatterns": [
        "/^installer/archive-pins\\.json$/"
      ],
      "matchStrings": [
        "www\\.powershellgallery\\.com/api/v2/package/(?<depName>[^/\"]+)/(?<currentValue>[^/\"]+)\""
      ],
      "datasourceTemplate": "nuget",
      "registryUrlTemplate": "https://www.powershellgallery.com/api/v2/"
    },
    {
      "customType": "regex",
      "description": "GNU Make release that the Windows make build packages. Renovate only reports it.",
      "managerFilePatterns": [
        "/^installer/archive-pins\\.json$/"
      ],
      "matchStrings": [
        "ezwinports/make-(?<currentValue>[0-9.]+)-without-guile"
      ],
      "datasourceTemplate": "git-tags",
      "depNameTemplate": "gnu-make",
      "packageNameTemplate": "https://git.savannah.gnu.org/git/make.git"
    },
    {
      "customType": "regex",
      "description": "Source commits of the shell and tmux plugin archives. Renovate only reports a newer commit.",
      "managerFilePatterns": [
        "/^installer/archive-pins\\.json$/"
      ],
      "matchStrings": [
        "codeload\\.github\\.com/(?<depName>[^/\"]+/[^/\"]+)/tar\\.gz/(?<currentDigest>[0-9a-f]{40})"
      ],
      "datasourceTemplate": "git-refs",
      "currentValueTemplate": "master",
      "packageNameTemplate": "https://github.com/{{depName}}"
    },
    {
      "customType": "regex",
      "description": "Tailscale Linux package. Renovate only reports it.",
      "managerFilePatterns": [
        "/^installer/linux-package-pins\\.json$/"
      ],
      "matchStrings": [
        "pkgs\\.tailscale\\.com/stable/tailscale_(?<currentValue>[0-9.]+)_"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "tailscale/tailscale",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "Go toolchain that the bootstrap verifies. Renovate only reports it; go.mod and the workflows change with it.",
      "managerFilePatterns": [
        "/^installer/bootstrap-toolchain\\.tsv$/"
      ],
      "matchStrings": [
        "(?:^|\\n)go(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\\t"
      ],
      "datasourceTemplate": "golang-version",
      "depNameTemplate": "go"
    },
    {
      "customType": "regex",
      "description": "Homebrew install script commit of the macOS bootstrap. Renovate only reports a newer commit.",
      "managerFilePatterns": [
        "/^installer/homebrew_bootstrap\\.go$/"
      ],
      "matchStrings": [
        "homebrewBootstrapCommit = \"(?<currentDigest>[0-9a-f]{40})\""
      ],
      "datasourceTemplate": "git-refs",
      "depNameTemplate": "Homebrew/install",
      "currentValueTemplate": "main",
      "packageNameTemplate": "https://github.com/Homebrew/install"
    },
    {
      "customType": "regex",
      "description": "Mason registry snapshot. Renovate only reports a newer registry release.",
      "managerFilePatterns": [
        "/^nvim/mason-registry/lock\\.json$/"
      ],
      "matchStrings": [
        "\"version\":\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "mason-org/mason-registry",
      "versioningTemplate": "loose"
    }
  ],
  "packageRules": [
    {
      "matchManagers": [
        "custom.regex"
      ],
      "groupName": "pinned CI tool constants",
      "addLabels": [
        "pinned-downloads"
      ],
      "automerge": false,
      "matchFileNames": [
        ".github/workflows/**",
        "scripts/validate-renovate.sh"
      ]
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github actions",
      "addLabels": [
        "github-actions"
      ],
      "pinDigests": true,
      "automerge": false
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchDatasources": [
        "github-runners"
      ],
      "groupName": "github runner images",
      "addLabels": [
        "github-runners"
      ],
      "automerge": false
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchDatasources": [
        "github-runners"
      ],
      "groupName": "github runner images",
      "addLabels": [
        "github-runners"
      ],
      "automerge": false
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchDepNames": [
        "ubuntu"
      ],
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch"
      ],
      "enabled": false,
      "automerge": false
    },
    {
      "matchFileNames": [
        "installer/archive-pins.json",
        "installer/linux-code-pins.json",
        "installer/linux-package-pins.json",
        "installer/bootstrap-toolchain.tsv",
        "installer/homebrew_bootstrap.go",
        "nvim/mason-registry/lock.json"
      ],
      "dependencyDashboardApproval": true,
      "addLabels": [
        "pinned-downloads"
      ],
      "automerge": false
    },
    {
      "matchFileNames": [
        "installer/archive-pins.json"
      ],
      "matchDepNames": [
        "jqlang/jq"
      ],
      "versioning": "regex:^jq-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$",
      "automerge": false
    },
    {
      "matchFileNames": [
        "installer/archive-pins.json"
      ],
      "matchDepNames": [
        "xremap/xremap"
      ],
      "allowedVersions": "!/^v0\\.16\\.6$/",
      "automerge": false
    }
  ],
  "dependencyDashboardHeader": "Pinned downloads (archive pins, Linux package pins, the bootstrap Go toolchain, the Homebrew script and the Mason snapshot) are listed under Pending Approval as notices. Do not approve them here: Renovate cannot verify their checksums. The daily agent-cli-pins workflow proposes verified updates, and docs/RELEASING.md describes the manual ones."
}
