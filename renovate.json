{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Renovate owns GitHub Actions, runner labels, Go toolchain/modules, CI validator/tool constants and the Sentinel commit in installer/sentinel.go. Installer archive/component/wheel pins, linux-code-pins.json, bootstrap-toolchain.tsv and the Mason registry snapshot are manually reviewed with checksums and runtime proof; adjacent CI download hashes also require review after version bumps. The agent CLI archive pins (Claude Code, Codex, Copilot CLI, Kiro CLI) are instead proposed weekly by .github/workflows/agent-cli-pins.yml for the same review and native checks.",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":dependencyDashboard",
    ":semanticCommits",
    ":timezone(Etc/UTC)"
  ],
  "enabledManagers": [
    "github-actions",
    "custom.regex",
    "gomod"
  ],
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "Renovate dashboard",
  "schedule": [
    "before 06:00 on monday"
  ],
  "prConcurrentLimit": 4,
  "prHourlyLimit": 2,
  "labels": [
    "dependencies"
  ],
  "automerge": false,
  "rebaseWhen": "behind-base-branch",
  "vulnerabilityAlerts": {
    "enabled": false
  },
  "lockFileMaintenance": {
    "enabled": false
  },
  "ignorePaths": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.venv/**",
    "tests/.cache/**",
    "tests/nvim/fixtures/go.mod",
    "vendor/**"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Neovim Linux x86_64 tarball version in CI. The adjacent SHA-256 must be recomputed manually after Renovate bumps this.",
      "managerFilePatterns": [
        "/^\\.github/workflows/test\\.yml$/"
      ],
      "matchStrings": [
        "NVIM_LINUX_VERSION:\\s*(?<currentValue>v[^\\s]+)\\s+NVIM_LINUX_X86_64_SHA256:\\s*[a-f0-9]{64}"
      ],
      "depNameTemplate": "neovim/neovim",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Starship Linux x86_64 release version in CI. The adjacent SHA-256 must be recomputed manually after Renovate bumps this.",
      "managerFilePatterns": [
        "/^\\.github/workflows/test\\.yml$/"
      ],
      "matchStrings": [
        "STARSHIP_VERSION:\\s*(?<currentValue>v[^\\s]+)\\s+STARSHIP_LINUX_X86_64_SHA256:\\s*[a-f0-9]{64}"
      ],
      "depNameTemplate": "starship/starship",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "tree-sitter CLI Linux x86_64 release version in CI. The adjacent SHA-256 must be recomputed manually after Renovate bumps this.",
      "managerFilePatterns": [
        "/^\\.github/workflows/test\\.yml$/"
      ],
      "matchStrings": [
        "TREE_SITTER_CLI_LINUX_VERSION:\\s*(?<currentValue>v[^\\s]+)\\s+TREE_SITTER_CLI_LINUX_X86_64_SHA256:\\s*[a-f0-9]{64}"
      ],
      "depNameTemplate": "tree-sitter/tree-sitter",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "cargo-binstall installer script commit pinned to the current main branch digest. The adjacent installer script SHA-256 must be recomputed manually after Renovate bumps this.",
      "managerFilePatterns": [
        "/^\\.github/workflows/test\\.yml$/"
      ],
      "matchStrings": [
        "CARGO_BINSTALL_COMMIT:\\s*(?<currentDigest>[a-f0-9]{40})\\s+CARGO_BINSTALL_INSTALLER_SHA256:\\s*[a-f0-9]{64}"
      ],
      "currentValueTemplate": "main",
      "depNameTemplate": "cargo-bins/cargo-binstall",
      "packageNameTemplate": "https://github.com/cargo-bins/cargo-binstall",
      "datasourceTemplate": "git-refs"
    },
    {
      "customType": "regex",
      "description": "Sentinel commit that setup fetches and runs. Renovate proposes the new main digest; the commit hash is the integrity check.",
      "managerFilePatterns": [
        "/^installer/sentinel\\.go$/"
      ],
      "matchStrings": [
        "sentinelCommit\\s*=\\s*\"(?<currentDigest>[a-f0-9]{40})\""
      ],
      "currentValueTemplate": "main",
      "depNameTemplate": "luisgui1757/sentinel",
      "packageNameTemplate": "https://github.com/luisgui1757/sentinel",
      "datasourceTemplate": "git-refs"
    },
    {
      "customType": "regex",
      "description": "Node runtime version used to run Renovate's schema validator.",
      "managerFilePatterns": [
        "/^scripts/validate-renovate\\.sh$/"
      ],
      "matchStrings": [
        "RENOVATE_NODE_VERSION=\"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "node",
      "datasourceTemplate": "npm",
      "versioningTemplate": "node"
    },
    {
      "customType": "regex",
      "description": "Renovate package version used by the required schema validator.",
      "managerFilePatterns": [
        "/^scripts/validate-renovate\\.sh$/"
      ],
      "matchStrings": [
        "RENOVATE_VERSION=\"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "renovate",
      "datasourceTemplate": "npm",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "GitHub runner labels stored in matrix include entries, which the built-in manager cannot extract through matrix variables.",
      "managerFilePatterns": [
        "/^\\.github/workflows/installer-engine\\.yml$/"
      ],
      "matchStrings": [
        "runner:\\s*(?<depName>ubuntu|macos|windows)-(?<currentValue>[^\\s#]+)"
      ],
      "datasourceTemplate": "github-runners",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Pinned Windows container image used for fresh native installer acceptance.",
      "managerFilePatterns": [
        "/^\\.github/workflows/installer-engine\\.yml$/"
      ],
      "matchStrings": [
        "WINDOWS_TEST_IMAGE:\\s*(?<depName>mcr\\.microsoft\\.com/dotnet/framework/runtime):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Pinned oldest supported Ubuntu image for the Ghostty library-compatibility check. Only digest updates apply: the tag must stay the oldest supported release.",
      "managerFilePatterns": [
        "/^\\.github/workflows/installer-engine\\.yml$/"
      ],
      "matchStrings": [
        "GHOSTTY_OLDEST_UBUNTU_IMAGE:\\s*(?<depName>ubuntu):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchManagers": [
        "custom.regex"
      ],
      "groupName": "pinned CI tool constants",
      "addLabels": [
        "pinned-downloads"
      ],
      "automerge": false
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchDepNames": [
        "luisgui1757/sentinel"
      ],
      "groupName": "sentinel",
      "addLabels": [
        "sentinel"
      ],
      "automerge": false
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github actions",
      "addLabels": [
        "github-actions"
      ],
      "pinDigests": true,
      "automerge": false
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchDatasources": [
        "github-runners"
      ],
      "groupName": "github runner images",
      "addLabels": [
        "github-runners"
      ],
      "automerge": false
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchDatasources": [
        "github-runners"
      ],
      "groupName": "github runner images",
      "addLabels": [
        "github-runners"
      ],
      "automerge": false
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchDepNames": [
        "ubuntu"
      ],
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch"
      ],
      "enabled": false,
      "automerge": false
    }
  ]
}
