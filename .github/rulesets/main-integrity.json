{
  "name": "Protect main: integrity",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {
      "include": [
        "refs/heads/main"
      ],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": false,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": false,
        "allowed_merge_methods": [
          "squash"
        ]
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "do_not_enforce_on_create": false,
        "strict_required_status_checks_policy": true,
        "required_status_checks": [
          {
            "context": "ubuntu",
            "integration_id": 15368
          },
          {
            "context": "macos",
            "integration_id": 15368
          },
          {
            "context": "windows",
            "integration_id": 15368
          },
          {
            "context": "core (ubuntu-26.04)",
            "integration_id": 15368
          },
          {
            "context": "core (ubuntu-26.04-arm)",
            "integration_id": 15368
          },
          {
            "context": "core (macos-26)",
            "integration_id": 15368
          },
          {
            "context": "core (windows-2025)",
            "integration_id": 15368
          },
          {
            "context": "Fresh Homebrew (macOS arm64)",
            "integration_id": 15368
          },
          {
            "context": "Fresh Debian APT (amd64)",
            "integration_id": 15368
          },
          {
            "context": "Fresh Debian APT (arm64)",
            "integration_id": 15368
          },
          {
            "context": "Fresh Ubuntu APT (amd64)",
            "integration_id": 15368
          },
          {
            "context": "Fresh Ubuntu APT (arm64)",
            "integration_id": 15368
          },
          {
            "context": "Missing Apple developer tools (macOS arm64)",
            "integration_id": 15368
          },
          {
            "context": "Fresh Windows vendor (VC-runtime)",
            "integration_id": 15368
          },
          {
            "context": "Fresh Windows vendor (Build-Tools)",
            "integration_id": 15368
          },
          {
            "context": "Neovim lifecycle (ubuntu-26.04)",
            "integration_id": 15368
          },
          {
            "context": "Neovim lifecycle (ubuntu-26.04-arm)",
            "integration_id": 15368
          },
          {
            "context": "Neovim lifecycle (macos-26)",
            "integration_id": 15368
          },
          {
            "context": "Neovim lifecycle (windows-2025)",
            "integration_id": 15368
          },
          {
            "context": "Desktop lifecycle (ubuntu-26.04)",
            "integration_id": 15368
          },
          {
            "context": "Desktop lifecycle (ubuntu-26.04-arm)",
            "integration_id": 15368
          },
          {
            "context": "Desktop lifecycle (macos-26)",
            "integration_id": 15368
          },
          {
            "context": "Desktop lifecycle (windows-2025)",
            "integration_id": 15368
          }
        ]
      }
    },
    {
      "type": "code_scanning",
      "parameters": {
        "code_scanning_tools": [
          {
            "tool": "CodeQL",
            "alerts_threshold": "errors",
            "security_alerts_threshold": "high_or_higher"
          }
        ]
      }
    },
    {
      "type": "required_linear_history"
    },
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    }
  ]
}
