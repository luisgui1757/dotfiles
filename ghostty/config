# Ghostty configuration — Rose Pine, tmux-friendly, Hack Nerd Font.
# Install path:
#   macOS  → ~/Library/Application Support/com.mitchellh.ghostty/config
#   Linux  → ~/.config/ghostty/config
# (chezmoi manages this file at the OS-specific path.)

# ---- Theme -------------------------------------------------------------------
# ALWAYS the dark Rose Pine theme, every platform -- NOT adaptive
# (`dark:Rose Pine,light:Rose Pine Dawn`). The whole stack (nvim, tmux, starship,
# Windows Terminal) is dark Rose Pine; a light desktop -- e.g. a fresh GNOME
# Ubuntu, which defaults to light -- would otherwise flip ghostty to the cream
# Rose Pine Dawn variant, which is inconsistent and jarring. Keep this NON-split.
theme = Rose Pine

# ---- Font --------------------------------------------------------------------
font-family = Hack Nerd Font
font-size = 13
font-feature = +liga
font-feature = +calt

# ---- Window ------------------------------------------------------------------
# Mild translucency only — heavy blur compounds compositing cost when running
# tmux with frequent redraws. If you want full opacity, set both to 1.0 / 0.
background-opacity = 0.95
background-blur-radius = 15
window-padding-x = 6
window-padding-y = 6
window-padding-balance = true
# Open maximized on every platform. window-save-state stays `default` (NOT
# `always`): on macOS `always` restores the last window geometry AFTER
# `maximize` applies and overrides it, so the window wouldn't reliably open
# maximized. `default` only restores on an OS-driven reopen, so normal launches
# stay maximized while macOS session restore still works. (No-op on Linux/GTK.)
maximize = true
window-save-state = default
macos-titlebar-style = tabs
macos-option-as-alt = true

# ---- Cursor / mouse ----------------------------------------------------------
cursor-style = block
cursor-style-blink = false
mouse-hide-while-typing = true
copy-on-select = clipboard

# ---- Shell integration -------------------------------------------------------
shell-integration = detect
shell-integration-features = cursor,sudo,title

# ---- Scrollback / clipboard --------------------------------------------------
# Ghostty measures scrollback in bytes, not lines. Keep a lazy 1 GiB budget per
# terminal surface so long-running sessions can retain roughly millions of
# ordinary log lines without claiming the memory up front.
scrollback-limit = 1073741824
clipboard-read = ask
clipboard-write = allow
clipboard-paste-protection = true

# ---- Keybindings -------------------------------------------------------------
# Avoid clashing with tmux prefix (C-Space) and nvim Alt-h/j/k/l window nav.
# Ctrl+Option+` shows the quick terminal from any app, next to the AeroSpace
# Ctrl+Option keys. Cmd+` stays the macOS key for the next window of the app.
keybind = global:ctrl+alt+grave_accent=toggle_quick_terminal
# Option+Left/Right send Esc b / Esc f, the Ghostty default on macOS, also on
# Linux. zsh, bash, fzf and Atuin move by word on these bytes.
keybind = alt+arrow_left=esc:b
keybind = alt+arrow_right=esc:f
# Linux only: the Mac keyboard shortcuts (xremap) send these keys for Cmd+W and
# Cmd+Option+arrows, so splits work as on the Mac. Ghostty on Linux has no key
# to close one split, and GNOME takes its split keys Ctrl+Alt+arrows for
# workspaces. On macOS these chords (Ctrl+Cmd+W, Ctrl+Cmd+Option+arrows) are
# extra keys that nothing else uses.
keybind = ctrl+super+w=close_surface
keybind = ctrl+super+alt+arrow_up=goto_split:up
keybind = ctrl+super+alt+arrow_down=goto_split:down
keybind = ctrl+super+alt+arrow_left=goto_split:left
keybind = ctrl+super+alt+arrow_right=goto_split:right
